' Relationships
' Core Entity Relationships
Book ||--o{ Transaction : "has many"
User ||--o{ Transaction : "has many"
Transaction }o--|| Book : "references"
Transaction }o--|| User : "references"

' Database Layer Relationships
DatabaseManager --> DatabaseConfig : "uses"
DatabaseManager --> Book : "manages"
DatabaseManager --> User : "manages"
DatabaseManager --> Transaction : "manages"

' Business Logic Relationships
LibraryManager --> DatabaseManager : "uses"
LibraryManager --> Book : "manages"
LibraryManager --> User : "manages"
LibraryManager --> Transaction : "manages"

' UI Layer Relationships
LoginFrame --> LibraryManager : "uses"
AdminDashboard --> LibraryManager : "uses"
LibrarianDashboard --> LibraryManager : "uses"
MemberDashboard --> LibraryManager : "uses"
LibraryManagementSystem --> LoginFrame : "starts with"

' Singleton Pattern
LibraryManager ..> LibraryManager : "getInstance()"

' Enum Usage
User --> UserRole : "has"
Transaction --> TransactionType : "has"
Transaction --> TransactionStatus : "has"

' Notes
note top of Book : "Manages book inventory\nand availability\nwith active status"
note top of User : "Represents system users\nwith borrowing capacity\nand database integration"
note top of Transaction : "Tracks book borrowing\nand return history\nwith fine calculation"
note top of LibraryManager : "Singleton pattern\nCentral business logic\nwith database persistence"
note top of DatabaseManager : "Handles all database\noperations with comprehensive\nCRUD functionality"
note top of LoginFrame : "Entry point with\nRemember Me feature\nand credential persistence"
note top of LibrarianDashboard : "Transaction management\nwith overdue tracking\nand user search"
note top of MemberDashboard : "Book search and\nborrowing management\nwith capacity tracking"

