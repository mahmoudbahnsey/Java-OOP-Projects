    }

    class Transaction {
        -String transactionId
        -Book book
        -User user
        -LocalDateTime borrowDate
        -LocalDateTime dueDate
        -LocalDateTime returnDate
        -TransactionType type
        -TransactionStatus status
        -double fineAmount
        -String notes
        +Transaction(String transactionId, Book book, User user)
