        +void setStatus(TransactionStatus status)
        +void setFineAmount(double fineAmount)
        +void setNotes(String notes)
        +boolean isOverdue()
        +boolean canBeReturned()
        +void returnBook()
        +double calculateFine()
        +int getDaysOverdue()
        +String toString()
    }

    enum UserRole {
        ADMIN
        LIBRARIAN
        MEMBER
    }

    enum TransactionType {
        BORROW("Borrow")
        RETURN("Return")
        +String displayName
        +TransactionType(String displayName)
        +String toString()
    }

    enum TransactionStatus {
        ACTIVE("Active")
        RETURNED("Returned")
        OVERDUE("Overdue")
        CANCELLED("Cancelled")
        +String displayName
        +TransactionStatus(String displayName)
        +String toString()
    }
}

