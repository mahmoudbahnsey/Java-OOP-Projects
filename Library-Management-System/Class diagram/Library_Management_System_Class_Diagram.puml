        +String getTransactionId()
        +Book getBook()
        +User getUser()
        +LocalDateTime getBorrowDate()
        +LocalDateTime getDueDate()
        +LocalDateTime getReturnDate()
        +TransactionType getType()
        +TransactionStatus getStatus()
        +double getFineAmount()
        +String getNotes()
